    },
    {
      "name": "6. Rejected Request - App 2",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "url": "{{secondBaseUrl}}/api/resource"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sixth request is rejected with HTTP 429', function () {",
              "    pm.response.to.have.status(429);",
              "});",
              "",
              "pm.test('Retry-After header is present', function () {",
              "    pm.expect(pm.response.headers.has('Retry-After')).to.be.true;",
              "});",
              "",
              "pm.test('Rate-limit headers are present', function () {",
              "    pm.expect(pm.response.headers.has('X-RateLimit-Limit')).to.be.true;",
              "    pm.expect(pm.response.headers.has('X-RateLimit-Remaining')).to.be.true;",
              "});"
            ]
          }
        }
      ]
    }
  ]
