          }
        ],
        "url": "{{baseUrl}}/api/resource"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Third request is allowed', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Allowed Request - App 1",
      "request": {
        "method": "GET",
